+    PP2_SIGNATURE,
+    ProxyProtocol,
+    ProxyProtocolError,
+    parse_proxy_header,
+)
+
+
+CERT_DIR = os.path.join(
+    os.path.dirname(os.path.realpath(__file__)), "certs", "localhost"
+)
+CERT_FILE = os.path.join(CERT_DIR, "fullchain.pem")
+KEY_FILE = os.path.join(CERT_DIR, "privkey.pem")
