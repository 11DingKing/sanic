+    )
+    assert response.startswith(b"HTTP/1.1 200")
+    body = _json_body(response)
+    assert body["ip"] == "9.9.9.9"
+    assert body["port"] == 4321
+    assert body["client_ip"] == "9.9.9.9"
+    assert body["socket"] == ["9.9.9.9", 4321]
+    assert body["server_port"] == 80
