+    handler_runs = 0
+
+    @app.signal("foo.bar.baz")
+    async def handler(**_):
+        nonlocal handler_runs
+        handler_runs += 1
+
+    app.signal_router.finalize()
+
+    waiter = asyncio.create_task(app.event("foo.bar.baz"))
+    await asyncio.sleep(0)
